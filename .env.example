# Amazon Seller Central SP-API Credentials
# Copy this file to .env and fill in your values

# Your Amazon SP-API credentials (from Seller Central Developer Console)
SP_API_REFRESH_TOKEN=your_refresh_token_here
LWA_APP_ID=your_lwa_app_id_here
LWA_CLIENT_SECRET=your_lwa_client_secret_here

# AWS credentials (IAM user linked to your SP-API app)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# Your Amazon marketplace (default: US)
# Options: US, CA, MX, BR, ES, UK, FR, BE, NL, DE, IT, SE, ZA, PL, EG, TR, SA, AE, IN, SG, AU, JP
MARKETPLACE=US

# Your Seller ID (found in Seller Central under Settings > Account Info)
SELLER_ID=your_seller_id_here
